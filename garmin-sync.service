[Unit]
Description=My Health Garmin data sync
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/garmin-health/.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/garmin-health
EnvironmentFile=/root/garmin-health/.env
ExecStart=/root/garmin-health/venv/bin/python sync.py today
