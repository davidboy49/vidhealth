[Unit]
Description=Hermes Health Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/garmin-health
ExecStart=/root/garmin-health/venv/bin/streamlit run dashboard/dashboard.py --server.port 8093 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
